 {
  "id": "cao-wuhui-szu-latex-master-template",
  "repo": "Cao-Wuhui/SZU_Latex_Master_Template",
  "sha": "79c3ba378a933be2427d0787638458f9a45bce2d",
  "with": {
   "root_file": "master_pang.tex",
   "latexmk_use_xelatex": "true",
   "extra_system_packages": "font-noto-cjk font-dejavu fontconfig curl cabextract",
   "extra_fonts": "./simsun.ttc\n./songti-Bold.otf\n./lucida-console.ttf\n",
   "pre_compile": "# The footnote code in master_pang.tex checks fonts in order:\n#   Noto Sans Symbols 2 \u2192 Segoe UI Symbol \u2192 Symbola \u2192 Arial Unicode MS \u2192 DejaVu Sans\n# Noto Sans Symbols 2 doesn't contain \u2460\u2461\u2462 (U+2460), and Symbola has\n# stale TeX Live references that trick \\IfFontExistsTF but fail to load.\n# Remove both so the chain reaches DejaVu Sans, which has \u2460-\u2473.\nfind /usr/share/fonts -name '*Symbols2*' -delete 2>/dev/null || true\nfind /opt/texlive -name '*Symbols2*' -delete 2>/dev/null || true\nfind /opt/texlive -name '*ymbola*' -delete 2>/dev/null || true\n\n# Download and install Microsoft core fonts (Times New Roman, Arial)\n(\n  mkdir -p /tmp/msfonts && cd /tmp/msfonts\n  curl -sLO \"https://sourceforge.net/projects/corefonts/files/the%20fonts/final/arial32.exe\"\n  curl -sLO \"https://sourceforge.net/projects/corefonts/files/the%20fonts/final/times32.exe\"\n  cabextract -q *.exe\n  mkdir -p /usr/share/fonts/msttcorefonts\n  find . -iname '*.ttf' -exec cp {} /usr/share/fonts/msttcorefonts/ \\;\n)\n\n# SimHei is not available in standard Linux font repos;\n# map it to Noto Sans CJK SC via fontconfig alias.\n# To use the real SimHei, add simhei.ttf to the repo and extra_fonts list.\ncat > /etc/fonts/conf.d/99-simhei-alias.conf << 'FONTCFG'\n<?xml version=\"1.0\"?>\n<!DOCTYPE fontconfig SYSTEM \"fonts.dtd\">\n<fontconfig>\n  <alias>\n    <family>SimHei</family>\n    <prefer><family>Noto Sans CJK SC</family></prefer>\n  </alias>\n</fontconfig>\nFONTCFG\n\nfc-cache -fv\n"
  }
 },
